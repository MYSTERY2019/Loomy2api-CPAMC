# Scripts run on Linux: keep LF even when checked out on Windows (core.autocrlf).
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.so   binary
*.png  binary
*.jpg  binary
